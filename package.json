{
  "name": "agile-x-studio",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "export:gds": "uv run python scripts/export_gds.py",
    "export:fab": "uv run python scripts/export_gate_array.py",
    "dev:api": "uv run uvicorn server.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:vite": "vite",
    "dev:vite:en": "VITE_LOCALE=en vite",
    "predev": "npm run export:fab",
    "dev": "concurrently -k -n vite,api -c blue,green \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:en": "concurrently -k -n vite,api -c blue,green \"npm run dev:vite:en\" \"npm run dev:api\"",
    "prebuild": "npm run export:fab",
    "build": "npm run build:ja",
    "build:ja": "VITE_LOCALE=ja tsc -b && VITE_LOCALE=ja vite build",
    "build:en": "VITE_LOCALE=en tsc -b && VITE_LOCALE=en vite build",
    "build:all": "npm run build:ja && npm run build:en",
    "lint": "eslint .",
    "docs:serve": "uv run --only-group docs mkdocs serve -a 127.0.0.1:8001",
    "docs:build": "uv run --only-group docs mkdocs build --strict",
    "test:ga": "uv run python server/test_ga_layout.py",
    "preview": "vite preview",
    "preview:en": "vite preview --outDir dist-en"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.11.0",
    "lucide-react": "^1.17.0",
    "rbush": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.4.3"
  }
}
